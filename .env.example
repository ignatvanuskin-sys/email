DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-at-least-32-random-characters"
CREDENTIALS_KEY="base64-encoded-32-byte-key"
MOCK_AI=true
MOCK_EMAIL=true
APP_URL="http://localhost:3000"
WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
CRON_SECRET="replace-with-at-least-32-random-characters"
ENABLE_TELEGRAM="true"
ENABLE_SHOPIFY="true"
ENABLE_ADVANCED_JOURNEYS="true"
ENABLE_BILLING="true"
ENABLE_HTML_BUILDER="true"
TELEGRAM_WEBHOOK_SECRET="replace-with-random-secret-token"

# Call POST /api/internal/worker every minute with:
# Authorization: Bearer <CRON_SECRET>
