# Required in production
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Base64 encoding of exactly 32 random bytes
CREDENTIALS_KEY="base64-encoded-32-byte-key"
APP_URL="http://localhost:3000"
BOUNCE_WEBHOOK_SECRET="local-webhook-secret-change-me-32-characters"
UNSUBSCRIBE_SECRET="local-unsubscribe-secret-change-me-32-characters"

# Keep mocks enabled only for local development/tests
MOCK_AI=true
MOCK_EMAIL=true
